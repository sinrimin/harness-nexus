{
  "name": "harnessnexus",
  "version": "0.0.0",
  "private": true,
  "description": "Harness Nexus — a unified management platform for MCP servers, skills, hooks, sub-agents, rules, and profiles across coding-agent tools (Claude Code, ZCode, Hermes, etc.).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @harness-nexus/server run dev",
    "dev:web": "pnpm --filter @harness-nexus/web run dev",
    "start:server": "pnpm --filter @harness-nexus/server run start",
    "smoke": "node scripts/smoke.mjs",
    "ui-snap": "node scripts/ui-snap.mjs",
    "ui-snap:update": "node scripts/ui-snap.mjs --update",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r exec rimraf dist node_modules .turbo"
  },
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.3",
    "puppeteer-core": "^25.11.0",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.6.3"
  }
}
