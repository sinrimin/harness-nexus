{
  "name": "@harness-nexus/server",
  "version": "0.0.0",
  "private": true,
  "description": "Harness Nexus API server — Fastify HTTP API, MCP proxy transport, and storage drivers.",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "harness-nexus-server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint placeholder) add eslint/oxlint config\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "@harness-nexus/core": "workspace:*",
    "@harness-nexus/mcp-runtime": "workspace:^",
    "@harness-nexus/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.10.0",
    "fastify-socket.io": "^5.1.0",
    "jose": "^6.2.3",
    "jszip": "^3.10.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.8.6",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  }
}
