{
  "name": "@harness-nexus/cli",
  "version": "0.1.0-alpha.6",
  "description": "Harness Nexus one-click install CLI \u2014 pulls profiles/resources and writes them into a target Agent tool.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "harness-nexus": "./dist/index.js",
    "hnx": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('node:fs');fs.cpSync('src/daemon/dsh-tap','dist/daemon/dsh-tap',{recursive:true})\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint placeholder) add eslint/oxlint config\"",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@harness-nexus/core": "workspace:*",
    "@harness-nexus/mcp-runtime": "workspace:^",
    "@harness-nexus/sdk": "workspace:*",
    "@harness-nexus/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "js-yaml": "^4.1.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.8.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinrimin/harness-nexus.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
