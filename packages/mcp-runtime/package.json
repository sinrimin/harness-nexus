{
  "name": "@harness-nexus/mcp-runtime",
  "version": "0.1.0-alpha.6",
  "description": "Transport-facing MCP upstream pool \u2014 dial upstreams (SSE / Streamable HTTP / stdio), aggregate namespaced tools, route calls. Shared by the server's McpRegistry and the `hnx mcp serve` stdio shim (Phase 8 C2).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint placeholder) add eslint/oxlint config\"",
    "test": "echo \"(test placeholder) add vitest\"",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@harness-nexus/core": "workspace:*",
    "@harness-nexus/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinrimin/harness-nexus.git",
    "directory": "packages/mcp-runtime"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
